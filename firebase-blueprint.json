{
  "entities": {
    "School": {
      "title": "School",
      "description": "Unidade escolar cadastrada na plataforma SaaS EduScope 360.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "codeCie": { "type": "string" },
        "network": { "type": "string" },
        "city": { "type": "string" },
        "address": { "type": "string" },
        "phone": { "type": "string" },
        "directorName": { "type": "string" },
        "active": { "type": "boolean" },
        "modules": { "type": "object" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "name", "active"]
    },
    "UserAccount": {
      "title": "UserAccount",
      "description": "Operador escolar vinculado a uma unidade escolar ou administrador global.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "username": { "type": "string" },
        "role": { "type": "string" },
        "roleLabel": { "type": "string" },
        "pin": { "type": "string" },
        "active": { "type": "boolean" },
        "schoolId": { "type": "string" },
        "isUniversal": { "type": "boolean" },
        "notes": { "type": "string" },
        "createdAt": { "type": "string" },
        "lastLogin": { "type": "string" }
      },
      "required": ["id", "name", "role", "active"]
    },
    "SchoolClass": {
      "title": "SchoolClass",
      "description": "Turma escolar vinculada a uma unidade escolar.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "schoolId": { "type": "string" },
        "name": { "type": "string" },
        "grade": { "type": "string" },
        "shift": { "type": "string" },
        "teacher": { "type": "string" },
        "totalStudents": { "type": "number" },
        "active": { "type": "boolean" }
      },
      "required": ["id", "schoolId", "name"]
    },
    "Student": {
      "title": "Student",
      "description": "Estudante matriculado em uma unidade escolar.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "schoolId": { "type": "string" },
        "name": { "type": "string" },
        "ra": { "type": "string" },
        "classId": { "type": "string" },
        "className": { "type": "string" },
        "guardianName": { "type": "string" },
        "guardianPhone": { "type": "string" },
        "status": { "type": "string" },
        "riskLevel": { "type": "string" }
      },
      "required": ["id", "schoolId", "name", "classId"]
    },
    "AttendanceRecord": {
      "title": "AttendanceRecord",
      "description": "Registro diário de frequência escolar por estudante.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "schoolId": { "type": "string" },
        "studentId": { "type": "string" },
        "classId": { "type": "string" },
        "date": { "type": "string" },
        "status": { "type": "string" },
        "recordedBy": { "type": "string" }
      },
      "required": ["id", "schoolId", "studentId", "classId", "date", "status"]
    },
    "ParentAlert": {
      "title": "ParentAlert",
      "description": "Alerta ou notificação enviada aos responsáveis.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "schoolId": { "type": "string" },
        "studentId": { "type": "string" },
        "studentName": { "type": "string" },
        "channel": { "type": "string" },
        "status": { "type": "string" },
        "sentAt": { "type": "string" },
        "messageContent": { "type": "string" }
      },
      "required": ["id", "schoolId", "studentId", "status"]
    },
    "InterventionCase": {
      "title": "InterventionCase",
      "description": "Caso de busca ativa e acompanhamento pedagógico.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "schoolId": { "type": "string" },
        "studentId": { "type": "string" },
        "studentName": { "type": "string" },
        "priority": { "type": "string" },
        "stage": { "type": "string" },
        "openedAt": { "type": "string" },
        "reason": { "type": "string" }
      },
      "required": ["id", "schoolId", "studentId", "stage"]
    },
    "GateRecord": {
      "title": "GateRecord",
      "description": "Registro de atraso na entrada ou saída antecipada na portaria.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "schoolId": { "type": "string" },
        "studentId": { "type": "string" },
        "studentName": { "type": "string" },
        "type": { "type": "string" },
        "date": { "type": "string" },
        "time": { "type": "string" },
        "reason": { "type": "string" }
      },
      "required": ["id", "schoolId", "studentId", "type", "date"]
    },
    "OcorrenciaRecord": {
      "title": "OcorrenciaRecord",
      "description": "Registro individual de ocorrência disciplinar ou mediação escolar (subcoleção isolada por escola).",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "schoolId": { "type": "string" },
        "data": { "type": "string" },
        "aula": { "type": "string" },
        "turma": { "type": "string" },
        "estudante": { "type": "string" },
        "professor": { "type": "string" },
        "ocorrencia": { "type": "string" },
        "medida": { "type": "string" },
        "descricao": { "type": "string" },
        "status": { "type": "string" }
      },
      "required": ["id", "schoolId", "estudante"]
    },
    "TratativaFamilia": {
      "title": "TratativaFamilia",
      "description": "Registro de atendimento e mediação com responsáveis (subcoleção isolada por escola).",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "schoolId": { "type": "string" },
        "estudante": { "type": "string" },
        "data": { "type": "string" },
        "relato": { "type": "string" }
      },
      "required": ["id", "schoolId"]
    },
    "TabletAgendamento": {
      "title": "TabletAgendamento",
      "description": "Reserva individual de tablets ou equipamentos pedagógicos (subcoleção isolada por escola).",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "schoolId": { "type": "string" },
        "data": { "type": "string" },
        "aula": { "type": "string" },
        "professor": { "type": "string" },
        "turma": { "type": "string" },
        "quantity": { "type": "number" },
        "equipmentType": { "type": "string" }
      },
      "required": ["id", "schoolId", "data", "aula"]
    },
    "ModuleConfig": {
      "title": "ModuleConfig",
      "description": "Configurações de listas, horários, feriados e inventário de um módulo escolar.",
      "type": "object",
      "properties": {
        "schoolId": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["schoolId"]
    },
    "SystemData": {
      "title": "SystemData",
      "description": "Documentos de configuração escolar (calendário letivo, grade docente, workspace de horários e legado).",
      "type": "object",
      "properties": {
        "schoolId": { "type": "string" },
        "updatedAt": { "type": "string" }
      }
    },
    "AdminMember": {
      "title": "AdminMember",
      "description": "Registro de administradores globais autorizados por UID do Firebase Auth.",
      "type": "object",
      "properties": {
        "email": { "type": "string" },
        "role": { "type": "string" }
      },
      "required": ["email", "role"]
    }
  },
  "firestore": {
    "/schools/{schoolId}": {
      "schema": { "$ref": "#/entities/School" },
      "description": "Unidades escolares cadastradas no SaaS."
    },
    "/schools/{schoolId}/module_config/{moduleId}": {
      "schema": { "$ref": "#/entities/ModuleConfig" },
      "description": "Configurações isoladas por escola para Ocorrências e Tablets."
    },
    "/schools/{schoolId}/ocorrencias/{recordId}": {
      "schema": { "$ref": "#/entities/OcorrenciaRecord" },
      "description": "Subcoleção escalável de ocorrências individuais por escola."
    },
    "/schools/{schoolId}/tratativas_familia/{tratativaId}": {
      "schema": { "$ref": "#/entities/TratativaFamilia" },
      "description": "Subcoleção de tratativas com a família por escola."
    },
    "/schools/{schoolId}/tablets_agendamentos/{agendamentoId}": {
      "schema": { "$ref": "#/entities/TabletAgendamento" },
      "description": "Subcoleção escalável de reservas de equipamentos por escola."
    },
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserAccount" },
      "description": "Operadores escolares e perfil Master."
    },
    "/classes/{classId}": {
      "schema": { "$ref": "#/entities/SchoolClass" },
      "description": "Turmas escolares isoladas por schoolId."
    },
    "/students/{studentId}": {
      "schema": { "$ref": "#/entities/Student" },
      "description": "Estudantes isolados por schoolId."
    },
    "/attendance_records/{recordId}": {
      "schema": { "$ref": "#/entities/AttendanceRecord" },
      "description": "Registros diários de chamada isolados por schoolId."
    },
    "/alerts/{alertId}": {
      "schema": { "$ref": "#/entities/ParentAlert" },
      "description": "Alertas a responsáveis isolados por schoolId."
    },
    "/interventions/{interventionId}": {
      "schema": { "$ref": "#/entities/InterventionCase" },
      "description": "Casos de busca ativa isolados por schoolId."
    },
    "/gate_records/{recordId}": {
      "schema": { "$ref": "#/entities/GateRecord" },
      "description": "Registros de portaria isolados por schoolId."
    },
    "/system_data/{docId}": {
      "schema": { "$ref": "#/entities/SystemData" },
      "description": "Calendário escolar, grade docente, workspace de horários e documentos legados para migração."
    },
    "/admins/{uid}": {
      "schema": { "$ref": "#/entities/AdminMember" },
      "description": "Tabela de administradores globais verificados via Firebase Auth UID."
    }
  }
}
